{
	"ci": {
		"collect": {
			"startServerCommand": "npm run preview -- --port 4174 --strictPort",
			"startServerReadyPattern": "Local",
			"url": [
				"http://localhost:4174/hoola-ai/",
				"http://localhost:4174/hoola-ai/theme/",
				"http://localhost:4174/hoola-ai/gallery/",
				"http://localhost:4174/hoola-ai/motion/",
				"http://localhost:4174/hoola-ai/train/",
				"http://localhost:4174/hoola-ai/records/"
			],
			"numberOfRuns": 3
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.9,
						"aggregationMethod": "median"
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.95,
						"aggregationMethod": "median"
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.9,
						"aggregationMethod": "median"
					}
				],
				"total-blocking-time": [
					"error",
					{
						"maxNumericValue": 200,
						"aggregationMethod": "median"
					}
				],
				"largest-contentful-paint": [
					"error",
					{
						"maxNumericValue": 2500,
						"aggregationMethod": "median"
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
